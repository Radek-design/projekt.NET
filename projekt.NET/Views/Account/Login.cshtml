@{
    ViewData["Title"] = "Logowanie";
}

<div class="container mt-5 pt-4">
    <div class="row justify-content-center">
        <div class="col-12 col-md-8 col-lg-5">
            <div class="glass-card p-4 p-md-5 shadow-lg">
                <div class="text-center mb-4">
                    <i class="bi bi-person-bounding-box" style="font-size: 3.5rem; color: var(--accent-primary);"></i>
                    <h2 class="fw-bold text-white mt-2">Zaloguj się</h2>
                </div>

                <form asp-controller="Account" asp-action="Login" method="post">

                    @if (!ViewData.ModelState.IsValid)
                    {
                        <div class="alert glass-card border-danger text-danger py-2 mb-3">
                            <div asp-validation-summary="All" class="small"></div>
                        </div>
                    }

                    <div class="mb-3">
                        <label for="username" class="form-label text-muted small fw-semibold">Nazwa Użytkownika</label>
                        <div class="input-group">
                            <span class="input-group-text bg-dark border-secondary text-info"><i class="bi bi-person"></i></span>
                            <input type="text" name="username" id="username" class="form-control bg-dark text-white glass-input" required placeholder="Wpisz nazwę użytkownika" />
                        </div>
                    </div>

                    <div class="mb-4">
                        <label for="password" class="form-label text-muted small fw-semibold">Hasło</label>
                        <div class="input-group">
                            <span class="input-group-text bg-dark border-secondary text-info"><i class="bi bi-key"></i></span>
                            <input type="password" name="password" id="password" class="form-control bg-dark text-white glass-input" required placeholder="Wprowadź hasło" />
                        </div>
                    </div>

                    <div class="d-grid gap-2">
                        <button type="submit" class="btn btn-info fw-bold py-2 text-dark" style="border-radius: 8px;">Zaloguj się</button>
                    </div>
                </form>

                <div class="text-center mt-4 pt-3 border-top border-glass">
                    <span class="text-muted small">Nie masz jeszcze konta?</span>
                    <a asp-controller="Account" asp-action="Register" class="text-info fw-bold text-decoration-none ms-1">Zarejestruj się tutaj</a>
                </div>
            </div>
        </div>
    </div>
</div>