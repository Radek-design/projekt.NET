@{
    ViewData["Title"] = "Rejestracja";
}

<div class="container mt-5">
    <div class="row justify-content-center">
        <div class="col-md-5">
            <div class="card shadow border-0 rounded-3">
                <div class="card-header bg-success text-white text-center py-3">
                    <h4 class="mb-0 fw-bold">Utwórz nowe konto</h4>
                </div>
                <div class="card-body p-4">
                    <form asp-controller="Account" asp-action="Register" method="post">

                        @if (!ViewData.ModelState.IsValid)
                        {
                            <div class="alert alert-danger py-2">
                                <div asp-validation-summary="All" class="small text-danger"></div>
                            </div>
                        }

                        <div class="mb-3">
                            <label for="displayname" class="form-label fw-semibold">Nazwa użytkownika (Nick)</label>
                            <input type="text" name="displayname" id="displayname" class="form-control" required placeholder="np. RadekDesign" />
                        </div>

                        <div class="mb-3">
                            <label for="email" class="form-label fw-semibold">Adres E-mail</label>
                            <input type="email" name="email" id="email" class="form-control" required placeholder="np. radek@przyklad.pl" />
                        </div>

                        <div class="mb-4">
                            <label for="password" class="form-label fw-semibold">Hasło</label>
                            <input type="password" name="password" id="password" class="form-control" required placeholder="Min. 6 znaków, cyfra, wielka litera" />
                        </div>

                        <div class="d-grid gap-2">
                            <button type="submit" class="btn btn-success fw-bold py-2">Zarejestruj mnie</button>
                        </div>
                    </form>
                </div>
                <div class="card-footer text-center py-3 bg-light border-0">
                    <p class="mb-0 text-muted">Masz już konto? <a asp-controller="Account" asp-action="Login" class="text-success fw-bold text-decoration-none">Zaloguj się</a></p>
                </div>
            </div>
        </div>
    </div>
</div>