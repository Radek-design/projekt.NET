@model IEnumerable<projekt.NET.Models.ForumPost>
@{
    ViewData["Title"] = "Forum Graczy";
}

<div class="container mt-4">
    <div class="glass-card p-4 mb-4 d-flex align-items-center gap-3">
        <i class="bi bi-chat-square-dots" style="font-size: 2.5rem; color: var(--accent-primary);"></i>
        <div>
            <h2 class="text-white mb-0 fw-bold">Społeczność i Dyskusje</h2>
            <p class="text-muted mb-0 small">Zadawaj pytania, rozwiązuj problemy i dyskutuj o ulubionych grach.</p>
        </div>
    </div>

    @if (TempData["ForumMsg"] != null)
    {
        <div class="alert glass-card border-success text-success shadow-sm">
            <i class="bi bi-check-circle-fill me-2"></i> @TempData["ForumMsg"]
        </div>
    }

    <div class="row g-4 flex-column-reverse flex-lg-row">
        <div class="col-12 col-lg-8">
            <div class="d-flex flex-column flex-sm-row justify-content-between align-items-sm-center mb-4 gap-3 border-bottom border-glass pb-3">

                <h4 class="text-light m-0 fw-bold">Wątki na forum</h4>

                <form method="get" asp-action="Index" class="m-0 w-100">
                    <div class="d-flex flex-column flex-xl-row gap-2">
                        <div class="input-group">
                            <span class="input-group-text bg-dark border-secondary text-info"><i class="bi bi-funnel"></i></span>
                            <select name="topicFilter" class="form-select bg-dark text-white glass-input" onchange="this.form.submit()">
                                <option value="">-- Wszystkie Tematy --</option>
                                <option value="Dyskusja ogólna" selected="@(ViewBag.CurrentFilter == "Dyskusja ogólna")">Dyskusja ogólna</option>
                                <option value="Problemy techniczne" selected="@(ViewBag.CurrentFilter == "Problemy techniczne")">Problemy techniczne</option>
                                @if (ViewBag.Games != null)
                                {
                                    foreach (var g in ViewBag.Games)
                                    {
                                        <option value="@g.Title" selected="@(ViewBag.CurrentFilter == g.Title)">Gra: @g.Title</option>
                                    }
                                }
                            </select>
                        </div>

                        <div class="input-group">
                            <span class="input-group-text bg-dark border-secondary text-info"><i class="bi bi-search"></i></span>
                            <input type="text" name="searchString" class="form-control bg-dark text-white glass-input"
                                   value="@ViewBag.CurrentSearch" placeholder="Szukaj słowa..." />
                            <button type="submit" class="btn btn-primary">Szukaj</button>
                            <a asp-action="Index" class="btn btn-secondary" title="Wyczyść filtry"><i class="bi bi-x-lg"></i></a>
                        </div>
                    </div>
                </form>

            </div>

            <div class="d-flex flex-column gap-3">
                @if (Model != null && Model.Any())
                {
                    foreach (var post in Model)
                    {
                        <div class="glass-card p-3 p-md-4">
                            <div class="d-flex justify-content-between align-items-center mb-3">
                                <span class="fw-bold text-white fs-5">@post.Title</span>
                                <span class="badge bg-dark border border-secondary text-info">@post.Topic</span>
                            </div>

                            @if (post.IsDeletedByModerator)
                            {
                                <div class="alert glass-card border-danger text-danger p-2 mb-0 small">
                                    <i class="bi bi-exclamation-triangle-fill"></i> Wątek został usunięty przez moderatora.
                                </div>
                            }
                            else
                            {
                                @if (!post.IsApproved)
                                {
                                    <span class="badge bg-danger mb-3">Wpis widoczny tylko dla Ciebie (Oczekuje na akceptację moda)</span>
                                }

                                <p class="text-muted" style="white-space: pre-wrap; display: -webkit-box; -webkit-line-clamp: 3; -webkit-box-orient: vertical; overflow: hidden;">@post.Content</p>

                                @if (!string.IsNullOrEmpty(post.ImagePath))
                                {
                                    <div class="mt-3 mb-3">
                                        <img src="@post.ImagePath" alt="Załączony obrazek" class="img-fluid rounded shadow-sm" style="max-height: 200px; object-fit: contain;" />
                                    </div>
                                }

                                <a asp-action="Details" asp-route-id="@post.Id" class="btn btn-info text-dark w-100 fw-bold mt-3" style="border-radius: 8px;">
                                    <i class="bi bi-chat-text me-1"></i> Wejdź w dyskusję i komentarze
                                </a>

                                @if (User.IsInRole("Moderator"))
                                {
                                    <div class="mt-3 pt-3 border-top border-glass d-flex gap-2 flex-wrap">
                                        @if (!post.IsApproved)
                                        {
                                            <form asp-action="ApprovePost" method="post" class="m-0 flex-grow-1">
                                                <input type="hidden" name="id" value="@post.Id" />
                                                <button class="btn btn-sm btn-outline-success w-100 fw-bold" style="border-radius: 8px;"><i class="bi bi-check-lg"></i> Zatwierdź wpis</button>
                                            </form>
                                        }
                                        <form asp-action="DeletePost" method="post" class="m-0 flex-grow-1" onsubmit="return confirm('Oflagować ten wpis jako usunięty?');">
                                            <input type="hidden" name="id" value="@post.Id" />
                                            <button class="btn btn-sm btn-outline-danger w-100 fw-bold" style="border-radius: 8px;"><i class="bi bi-trash"></i> Usuń wpis</button>
                                        </form>
                                    </div>
                                }
                            }

                            <div class="mt-3 pt-2 border-top border-glass text-muted small d-flex justify-content-between align-items-center">
                                <span>
                                    <i class="bi bi-person text-info me-1"></i>
                                    <a asp-controller="Library" asp-action="CommunityScreenshots" asp-route-authorId="@post.UserId" class="text-warning text-decoration-none fw-bold" title="Zobacz galerię użytkownika">
                                        @post.User?.UserName
                                    </a>
                                </span>
                                <span><i class="bi bi-clock me-1"></i> @post.CreatedAt.ToString("dd.MM.yyyy HH:mm")</span>
                            </div>
                        </div>
                    }
                }
                else
                {
                    <div class="alert glass-card text-muted text-center p-4">Brak wpisów dla wybranego filtru. Zacznij dyskusję!</div>
                }
            </div>
        </div>

        <div class="col-12 col-lg-4">

            @if (User.Identity != null && User.Identity.IsAuthenticated)
            {
                <div class="glass-sidebar p-4 rounded-4 mb-4 border-accent" style="border-color: rgba(40, 167, 69, 0.4) !important;">
                    <h5 class="text-white fw-bold mb-3 border-bottom border-glass pb-2">
                        <i class="bi bi-pencil-square text-success me-2"></i> Zacznij nową dyskusję
                    </h5>

                    <form asp-action="CreatePost" method="post" enctype="multipart/form-data">
                        <div class="mb-3">
                            <label class="small text-muted fw-bold mb-1">Wybierz Temat:</label>
                            <select name="topic" required class="form-select bg-dark text-white glass-input">
                                <option value="Dyskusja ogólna">Dyskusja ogólna</option>
                                <option value="Problemy techniczne">Problemy techniczne</option>
                                @if (ViewBag.Games != null)
                                {
                                    <optgroup label="Gry z bazy">
                                        @foreach (var g in ViewBag.Games)
                                        {
                                            <option value="@g.Title">@g.Title</option>
                                        }
                                    </optgroup>
                                }
                            </select>
                        </div>

                        <div class="mb-3">
                            <label class="small text-muted fw-bold mb-1">Tytuł wątku:</label>
                            <input type="text" name="title" required class="form-control bg-dark text-white glass-input" placeholder="O czym chcesz napisać?" />
                        </div>

                        <div class="mb-3">
                            <label class="small text-muted fw-bold mb-1">Treść:</label>
                            <textarea name="content" required rows="4" class="form-control bg-dark text-white glass-input" placeholder="Rozwiń swoją myśl..."></textarea>
                        </div>

                        <div class="mb-4">
                            <label class="small text-muted fw-bold mb-1" for="imageFile">Dodaj zrzut ekranu (opcjonalnie):</label>
                            <input type="file" name="imageFile" id="imageFile" class="form-control bg-dark text-white glass-input" accept="image/*" />
                        </div>

                        <button type="submit" class="btn w-100 fw-bold text-dark" style="background-color: #28a745; border-radius: 8px;">
                            <i class="bi bi-send me-1"></i> Wyślij do zatwierdzenia
                        </button>
                    </form>
                </div>
            }
            else
            {
                <div class="alert glass-card text-muted mb-4 d-flex align-items-center gap-3">
                    <i class="bi bi-lock fs-4 text-warning"></i> Zaloguj się, aby móc dodawać wpisy na forum.
                </div>
            }

            <div class="glass-sidebar p-4 rounded-4 position-sticky" style="top: 100px;">
                <h5 class="text-white fw-bold border-bottom border-glass pb-2 mb-3"><i class="bi bi-bar-chart-fill text-info me-2"></i> Statystyki Forum</h5>
                <div class="d-flex justify-content-between align-items-center mb-2 small">
                    <span class="text-muted">Zarejestrowani:</span>
                    <strong class="text-white">@ViewBag.UserCount <i class="bi bi-people-fill text-warning ms-1"></i></strong>
                </div>
                <div class="d-flex justify-content-between align-items-center small">
                    <span class="text-muted">Napisane posty:</span>
                    <strong class="text-white">@ViewBag.PostCount <i class="bi bi-file-text-fill text-warning ms-1"></i></strong>
                </div>
            </div>

        </div>
    </div>
</div>