@model IEnumerable<projekt.NET.Models.Entities.Game>

@{
    ViewData["Title"] = "Przeglądaj wszystkie gry";
}

<div class="container mt-4">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <h2>Wszystkie gry z bazy</h2>

        <form method="get" asp-controller="Games" asp-action="Index" class="d-flex align-items-center">
            <label class="me-2 fw-bold">Gatunek:</label>
            <select name="genreId" class="form-select me-2" onchange="this.form.submit()" style="min-width: 200px;">
                <option value="">-- Wszystkie gatunki --</option>
                @if (ViewBag.Genres != null)
                {
                    foreach (var genre in ViewBag.Genres)
                    {
                        if (ViewBag.SelectedGenre == genre.Id)
                        {
                            <option value="@genre.Id" selected="selected">@genre.Name</option>
                        }
                        else
                        {
                            <option value="@genre.Id">@genre.Name</option>
                        }
                    }
                }
            </select>
            <noscript>
                <button type="submit" class="btn btn-primary">Filtruj</button>
            </noscript>
        </form>
    </div>

    <div class="row">
        @if (Model != null && Model.Any())
        {
            foreach (var game in Model)
            {
                <div class="col-md-3 mb-4">
                    <div class="card h-100 shadow-sm bg-dark text-white border-secondary">
                        <img src="@(string.IsNullOrEmpty(game.CoverImagePath) ? "https://images.igdb.com/igdb/image/upload/t_cover_big/nocover.png" : game.CoverImagePath)"
                             class="card-img-top" alt="@game.Title" style="height: 350px; object-fit: cover;">

                        <div class="card-body d-flex flex-column">
                            <h5 class="card-title text-info">@game.Title</h5>
                            <p class="card-text mb-1"><strong>Wydano:</strong> @game.ReleaseDate.ToString("yyyy")</p>
                            <p class="card-text mb-1"><strong>Średnia ocena:</strong> @(game.AverageRating > 0 ? game.AverageRating.ToString("0.0") : "Brak ocen") / 10</p>

                            <p class="card-text mb-2 text-muted">
                                @if (game.Genres != null && game.Genres.Any())
                                {
                                    @string.Join(", ", game.Genres.Select(g => g.Name))
                                }
                                else
                                {
                                    <span>Brak informacji o gatunku</span>
                                }
                            </p>

                            <form asp-controller="Library" asp-action="AddGame" method="post" class="mt-auto">
                                <input type="hidden" name="gameId" value="@game.Id" />

                                <select name="status" class="form-select form-select-sm mb-2 bg-dark text-white border-secondary" required onchange="toggleFields(this, @game.Id)">
                                    <option value="Planuje">Planuje</option>
                                    <option value="W trakcie">W trakcie</option>
                                    <option value="Ukończona">Ukończona</option>
                                </select>

                                <div id="extra-fields-@game.Id" style="display: none;">
                                    <input type="number" name="playTimeHours" class="form-control form-control-sm mb-2 bg-dark text-white border-secondary" placeholder="Czas gry (godz.)" min="0" value="0" />
                                    <input type="number" name="rating" class="form-control form-control-sm mb-2 bg-dark text-white border-secondary" placeholder="Ocena (1-10)" min="1" max="10" />
                                </div>

                                <button type="submit" class="btn btn-outline-success w-100">
                                    <i class="bi bi-plus-lg"></i> Dodaj do biblioteki
                                </button>
                            </form>
                        </div>
                    </div>
                </div>
            }
        }
        else
        {
            <div class="col-12">
                <div class="alert alert-warning">Brak gier spełniających kryteria.</div>
            </div>
        }
    </div>
</div>

@section Scripts {
    <script>
        // Pokazuje dodatkowe pola (Czas gry, Ocena) jeżeli status to nie "Planuje"
        function toggleFields(selectElement, gameId) {
            var extraFields = document.getElementById('extra-fields-' + gameId);
            if (selectElement.value !== "Planuje") {
                extraFields.style.display = "block";
            } else {
                extraFields.style.display = "none";
            }
        }
    </script>
}