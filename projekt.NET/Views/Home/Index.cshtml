@model IEnumerable<projekt.NET.Controllers.NewsItem>
@{
    ViewData["Title"] = "Strona Główna";
}

<div class="container py-3">
    <div class="text-center mb-5 py-3 bg-dark border border-secondary rounded shadow-sm">
        <h1 class="display-4 fw-bold text-info">Witaj w Centrum Gier</h1>
        <p class="lead text-muted mb-0">Twoje zintegrowane miejsce na wiadomości, kolekcje gier oraz statystyki.</p>
    </div>

    <div class="row">
        <div class="col-md-8">

            @if (User.IsInRole("Moderator"))
            {
                <div class="card bg-dark text-white border-info mb-4 shadow-sm">
                    <div class="card-header bg-info text-dark fw-bold">
                        <i class="bi bi-plus-circle"></i> Panel Moderatora: Dodaj Nową Premierę
                    </div>
                    <div class="card-body">
                        <form asp-controller="Home" asp-action="AddPremiere" method="post">
                            <div class="mb-2">
                                <label class="form-label small text-info fw-bold">Tytuł Gry</label>
                                <input type="text" name="title" class="form-control form-control-sm bg-dark text-white border-secondary" required placeholder="Wpisz nazwę nadchodzącej gry" />
                            </div>
                            <div class="mb-2">
                                <label class="form-label small text-info fw-bold">Data Premiery</label>
                                <input type="date" name="releaseDate" class="form-control form-control-sm bg-dark text-white border-secondary" required />
                            </div>

                            <div class="mb-2">
                                <label class="form-label small text-info fw-bold">Platformy (Przytrzymaj CTRL aby zaznaczyć kilka)</label>
                                <select name="selectedPlatforms" class="form-select form-select-sm bg-dark text-white border-secondary" multiple style="height: 90px;">
                                    @if (ViewBag.Platforms != null)
                                    {
                                        foreach (var platform in ViewBag.Platforms)
                                        {
                                            <option value="@platform.Id">@platform.Name</option>
                                        }
                                    }
                                </select>
                            </div>

                            <div class="mb-3">
                                <label class="form-label small text-info fw-bold">Gatunki (Przytrzymaj CTRL aby zaznaczyć kilka)</label>
                                <select name="selectedGenres" class="form-select form-select-sm bg-dark text-white border-secondary" multiple style="height: 90px;">
                                    @if (ViewBag.Genres != null)
                                    {
                                        foreach (var genre in ViewBag.Genres)
                                        {
                                            <option value="@genre.Id">@genre.Name</option>
                                        }
                                    }
                                </select>
                            </div>
                            <button type="submit" class="btn btn-info btn-sm text-dark fw-bold w-100">Zapisz premierę w bazie</button>
                        </form>
                    </div>
                </div>
            }

            <div class="d-flex justify-content-between align-items-center mb-4 border-bottom pb-2">
                <h3 class="text-info mb-0"><i class="bi bi-newspaper"></i> Najnowsze Wiadomości</h3>
                <form action="/Home/GenerateAiNews" method="post" class="m-0">
                    <button type="submit" class="btn btn-outline-info btn-sm">
                        <i class="bi bi-magic"></i> Generuj przez AI
                    </button>
                </form>
            </div>

            @if (Model != null && Model.Any())
            {
                foreach (var news in Model)
                {
                    <div class="card mb-4 bg-dark text-white border-secondary shadow-sm p-3">
                        <h4 class="text-info">@news.Title</h4>
                        <p>@news.Summary</p>
                        <small class="text-muted">
                            Źródło: <strong class="text-warning">@news.Source</strong> | Dodano: @news.PublishDate.ToString("dd.MM.yyyy")
                        </small>
                    </div>
                }
            }
            else
            {
                <div class="alert alert-secondary">Brak nowych wiadomości w tym momencie.</div>
            }
        </div>

        <div class="col-md-4">
            <h3 class="mb-4 text-warning border-bottom pb-2"><i class="bi bi-calendar-event"></i> Premiery z bazy danych</h3>

            <div class="list-group shadow">
                @if (ViewBag.Premieres != null && ((IEnumerable<projekt.NET.Models.Entities.Premiere>)ViewBag.Premieres).Any())
                {
                    foreach (var premiere in (IEnumerable<projekt.NET.Models.Entities.Premiere>)ViewBag.Premieres)
                    {
                        <div class="list-group-item bg-dark text-white border-secondary mb-3 rounded shadow-sm p-3">
                            <div class="d-flex w-100 justify-content-between align-items-center mb-2">
                                <h6 class="mb-0 text-warning fw-bold fs-5">@premiere.Game?.Title</h6>
                                <span class="badge bg-secondary text-light">@premiere.Game?.ReleaseDate.ToString("dd.MM.yyyy")</span>
                            </div>
                            <p class="mb-1 small text-muted">
                                Platformy:
                                <span class="text-info">
                                    @if (premiere.Game?.Platforms != null && premiere.Game.Platforms.Any())
                                    {
                                        @string.Join(", ", premiere.Game.Platforms.Select(p => p.Name))
                                    }
                                    else
                                    {
                                        <span>Brak informacji</span>
                                    }
                                </span>
                            </p>
                            <p class="mb-0 small text-muted">
                                Gatunek:
                                <span class="text-success">
                                    @if (premiere.Game?.Genres != null && premiere.Game.Genres.Any())
                                    {
                                        @string.Join(", ", premiere.Game.Genres.Select(g => g.Name))
                                    }
                                    else
                                    {
                                        <span>Brak informacji</span>
                                    }
                                </span>
                            </p>
                        </div>
                    }
                }
                else
                {
                    <div class="alert alert-secondary">Brak informacji o najbliższych premierach w bazie danych.</div>
                }
            </div>
        </div>
    </div>
</div>