@{
    ViewData["Title"] = "Strona Główna";
}

<div class="text-center py-5">
    <h1 class="display-3 fw-bold text-info mb-4">Witaj w Bazie Gier</h1>
    <p class="lead mb-5">Odkrywaj nowe tytuły, zarządzaj swoją kolekcją, oceniaj i dziel się opiniami z innymi graczami.</p>

    <!-- Poniżej zostawiamy kafle o projekcie -->
    <div class="row mt-5">
        <div class="col-md-4">
            <div class="p-4 bg-dark border border-secondary rounded h-100 card-game">
                <h3>🕹️ Ogromny Katalog</h3>
                <p>Przeglądaj gry, platformy i producentów. Importuj dane automatycznie!</p>
            </div>
        </div>
        <div class="col-md-4">
            <div class="p-4 bg-dark border border-secondary rounded h-100 card-game">
                <h3>📚 Twoja Biblioteka</h3>
                <p>Oznaczaj gry jako "Ukończone", "W trakcie" i eksportuj kolekcję do PDF/Excel.</p>
            </div>
        </div>
        <div class="col-md-4">
            <div class="p-4 bg-dark border border-secondary rounded h-100 card-game">
                <h3>🤖 Wsparcie AI</h3>
                <p>Automatyczne generowanie podsumowań recenzji gier dzięki sztucznej inteligencji.</p>
            </div>
        </div>
    </div>
</div>
