@model IEnumerable<projekt.NET.Controllers.NewsItem>
@{
    ViewData["Title"] = "Strona Główna";
}

<div class="container py-3">
    <div class="text-center mb-5 py-3 bg-dark border border-secondary rounded shadow-sm">
        <h1 class="display-4 fw-bold text-info">Witaj w Centrum Gier</h1>
        <p class="lead text-muted mb-0">Twoje zintegrowane miejsce na wiadomości, kolekcje gier oraz statystyki.</p>
    </div>

    <div class="row">
        <div class="col-md-8">
            <h3 class="mb-4 text-info border-bottom pb-2"><i class="bi bi-newspaper"></i> Najnowsze Wiadomości (AI Summary)</h3>

            @if (Model != null && Model.Any())
            {
                foreach (var news in Model)
                {
                    <div class="card mb-4 bg-dark text-white border-secondary shadow-sm">
                        <div class="row g-0">
                            @if (!string.IsNullOrEmpty(news.ImageUrl))
                            {
                                <div class="col-md-4">
                                    <img src="@news.ImageUrl" class="img-fluid rounded-start h-100" alt="@news.Title" style="object-fit: cover; min-height: 160px;">
                                </div>
                            }
                            <div class="col-md-8">
                                <div class="card-body d-flex flex-column h-100">
                                    <h5 class="card-title text-info mb-1">@news.Title</h5>
                                    <small class="text-muted mb-2">Opublikowano: @news.PublishDate.ToString("dd.MM.yyyy")</small>
                                    <p class="card-text flex-grow-1">@news.Summary</p>
                                    <div>
                                        <span class="badge bg-info text-dark"><i class="bi bi-robot"></i> Generowane przez AI</span>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>
                }
            }
            else
            {
                <div class="alert alert-secondary">Brak nowych wiadomości w tym momencie.</div>
            }
        </div>

        <div class="col-md-4">
            <h3 class="mb-4 text-warning border-bottom pb-2"><i class="bi bi-calendar-event"></i> Premiery w tym roku</h3>

            <div class="list-group shadow">
                @if (ViewBag.UpcomingReleases != null)
                {
                    foreach (var release in ViewBag.UpcomingReleases)
                    {
                        <div class="list-group-item bg-dark text-white border-secondary mb-3 rounded shadow-sm p-3">
                            <div class="d-flex w-100 justify-content-between align-items-center mb-2">
                                <h6 class="mb-0 text-warning fw-bold fs-5">@release.Title</h6>
                                <span class="badge bg-secondary text-light">@release.ReleaseDate</span>
                            </div>
                            <p class="mb-0 small text-muted">Platformy: <span class="text-info">@release.Platforms</span></p>
                        </div>
                    }
                }
                else
                {
                    <div class="alert alert-secondary">Brak informacji o najbliższych premierach.</div>
                }
            </div>
        </div>
    </div>
</div>