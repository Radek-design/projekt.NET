@model IEnumerable<projekt.NET.Models.UserGame>
@{
    ViewData["Title"] = "Moja Biblioteka";
}

<div class="container mt-4">
    <div class="row">
        <div class="col-md-3 mb-4">
            <div class="card bg-dark text-white border-secondary shadow-sm">
                <img src="@(string.IsNullOrEmpty(ViewBag.ProfilePicture) ? "https://cdn.pixabay.com/photo/2015/10/05/22/37/blank-profile-picture-973460_1280.png" : ViewBag.ProfilePicture)"
                     class="card-img-top" alt="Avatar" style="height: 250px; object-fit: cover;">
                <div class="card-body text-center border-bottom border-secondary">
                    <h5 class="text-info fw-bold">@User.Identity?.Name</h5>

                    <form asp-action="UpdateProfilePicture" method="post" class="mt-3">
                        <input type="url" name="avatarUrl" class="form-control form-control-sm bg-dark text-white border-secondary mb-2" placeholder="Zmień: Wklej link do zdjęcia" required>
                        <button type="submit" class="btn btn-outline-info btn-sm w-100">Ustaw nowy Avatar</button>
                    </form>
                </div>
                <ul class="list-group list-group-flush border-secondary small">
                    <li class="list-group-item bg-dark text-white border-secondary d-flex justify-content-between"><span>Liczba gier:</span> <strong class="text-info">@ViewBag.TotalGames</strong></li>
                    <li class="list-group-item bg-dark text-white border-secondary d-flex justify-content-between"><span>Łączny czas:</span> <strong class="text-info">@ViewBag.TotalTime h</strong></li>
                    <li class="list-group-item bg-dark text-white border-secondary d-flex justify-content-between" title="Na podstawie recenzji"><span>Najwyższa ocena:</span> <strong class="text-warning"><i class="bi bi-star-fill"></i> @(ViewBag.HighestRating > 0 ? ViewBag.HighestRating : "-")</strong></li>
                    <li class="list-group-item bg-dark text-white border-secondary d-flex justify-content-between" title="Na podstawie recenzji"><span>Najniższa ocena:</span> <strong class="text-danger"><i class="bi bi-star-fill"></i> @(ViewBag.LowestRating > 0 ? ViewBag.LowestRating : "-")</strong></li>
                </ul>
                <div class="card-body d-grid gap-2">
                    <a asp-action="GenerateReport" class="btn btn-danger btn-sm fw-bold"><i class="bi bi-file-earmark-pdf"></i> Pobierz Raport (.pdf)</a>
                    <a asp-action="MyReviews" class="btn btn-warning btn-sm fw-bold text-dark"><i class="bi bi-chat-left-text"></i> Zobacz moje recenzje</a>
                    <a asp-action="Screenshots" class="btn btn-info btn-sm fw-bold text-dark"><i class="bi bi-images"></i> Galeria zrzutów ekranu</a>
                </div>
            </div>
        </div>

        <div class="col-md-9">
            <h3 class="text-warning mb-4 border-bottom border-secondary pb-2">Moja Kolekcja</h3>

            <form method="get" asp-action="Index" class="d-flex mb-4">
                <label class="me-2 fw-bold text-light align-self-center">Filtruj po gatunku:</label>
                <select name="genreId" class="form-select form-select-sm bg-dark text-white border-secondary w-auto me-2" onchange="this.form.submit()">
                    <option value="">Wszystkie</option>
                    @foreach (var genre in ViewBag.Genres)
                    {
                        if (ViewBag.SelectedGenre == genre.Id)
                        {
                            <option value="@genre.Id" selected>@genre.Name</option>
                        }
                        else
                        {
                            <option value="@genre.Id">@genre.Name</option>
                        }
                    }
                </select>
                <noscript><button type="submit" class="btn btn-primary btn-sm">Filtruj</button></noscript>
            </form>

            <div class="row">
                @foreach (var item in Model)
                {
                    <div class="col-md-4 mb-4">
                        <div class="card h-100 bg-dark text-white border-secondary shadow-sm">
                            <a asp-controller="Games" asp-action="Details" asp-route-id="@item.GameId">
                                <img src="@(string.IsNullOrEmpty(item.Game?.CoverImagePath) ? "https://images.igdb.com/igdb/image/upload/t_cover_big/nocover.png" : item.Game.CoverImagePath)"
                                     class="card-img-top border-bottom border-secondary" style="height: 200px; object-fit: cover;">
                            </a>
                            <div class="card-body">
                                <h6 class="text-info fw-bold">@item.Game?.Title</h6>
                                <p class="small mb-2">Obecny status: <span class="badge bg-primary">@item.Status</span></p>

                                <form asp-action="EditGame" method="post" class="mt-3 p-2 border border-secondary rounded">
                                    <input type="hidden" name="gameId" value="@item.GameId" />
                                    <label class="small text-muted mb-1">Aktualizuj postęp:</label>

                                    <select name="status" class="form-select form-select-sm bg-dark text-white border-secondary mb-2">
                                        <option value="Planuje" selected="@(item.Status == "Planuje")">Planuje</option>
                                        <option value="W trakcie" selected="@(item.Status == "W trakcie")">W trakcie</option>
                                        <option value="Ukończona" selected="@(item.Status == "Ukończona")">Ukończona</option>
                                    </select>

                                    <div class="input-group input-group-sm mb-2">
                                        <span class="input-group-text bg-dark text-white border-secondary">Godziny:</span>
                                        <input type="number" name="playTimeHours" value="@item.PlayTimeHours" min="0" class="form-control bg-dark text-white border-secondary" />
                                    </div>
                                    <button type="submit" class="btn btn-sm btn-outline-warning w-100">Zapisz zmiany</button>
                                </form>

                                <a asp-controller="Games" asp-action="Details" asp-route-id="@item.GameId" class="btn btn-sm btn-info w-100 mt-2 text-dark fw-bold">Napisz / Zobacz recenzję</a>
                            </div>
                        </div>
                    </div>
                }
            </div>
        </div>
    </div>
</div>