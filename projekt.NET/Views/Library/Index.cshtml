@model IEnumerable<projekt.NET.Models.UserGame>

@{
    ViewData["Title"] = "Moja Biblioteka Gier";
}

<div class="container mt-4">
    <h2>Moja Biblioteka Gier</h2>

    <div class="row">
        @if (Model != null && Model.Any())
        {
            foreach (var item in Model)
            {
                <div class="col-md-4 mb-4">
                    <div class="card h-100 shadow-sm">
                        <img src="@(string.IsNullOrEmpty(item.Game?.CoverImagePath) ? "https://images.igdb.com/igdb/image/upload/t_cover_big/nocover.png" : item.Game.CoverImagePath)"
                             class="card-img-top" alt="@item.Game?.Title" style="height: 250px; object-fit: cover;">
                        
                        <div class="card-body">
                            <h5 class="card-title">@(item.Game?.Title ?? "Nieznany tytuł")</h5>
                            <p class="card-text">
                                <strong>Status:</strong> <span class="badge bg-primary">@item.Status</span><br />
                                <strong>Czas gry:</strong> @item.PlayTimeHours godz.<br />
                                <strong>Moja ocena:</strong> @(item.Rating.HasValue ? $"{item.Rating}/10" : "Brak")
                            </p>
                        </div>
                    </div>
                </div>
            }
        }
        else
        {
            <div class="col-12">
                <div class="alert alert-info">Twoja biblioteka jest pusta. Dodaj jakieś gry, aby zacząć je śledzić!</div>
            </div>
        }
    </div>
</div>