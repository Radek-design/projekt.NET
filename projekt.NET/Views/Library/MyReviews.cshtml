@using projekt.NET.Models.Entities
@model IEnumerable<Review>
@{
    ViewData["Title"] = "Moje Recenzje";
}

<div class="container mt-4">
    <h2 class="text-info mb-4 border-bottom border-secondary pb-2"><i class="bi bi-chat-left-text"></i> Recenzje, które napisałeś</h2>

    <a asp-action="Index" class="btn btn-outline-secondary mb-4"><i class="bi bi-arrow-left"></i> Wróć do biblioteki</a>

    @if (Model != null && Model.Any())
    {
        foreach (var review in Model)
        {
            <div class="card bg-dark text-white border-secondary mb-3 shadow-sm">
                <div class="card-header bg-transparent border-secondary d-flex justify-content-between">
                    <span class="text-warning fw-bold">Gra: @review.Game?.Title</span>
                    <span class="badge bg-warning text-dark"><i class="bi bi-star-fill"></i> @review.Rating/10</span>
                </div>
                <div class="card-body">
                    <p class="mb-0">@review.Content</p>
                </div>
                <div class="card-footer text-muted small bg-transparent border-secondary">
                    Napisano: @review.CreatedAt.ToString("dd.MM.yyyy HH:mm")
                </div>
            </div>
        }
    }
    else
    {
        <div class="alert alert-secondary">Nie napisałeś jeszcze żadnej recenzji.</div>
    }
</div>