@using projekt.NET.Models.Entities
@model IEnumerable<Review>
@{
    ViewData["Title"] = "Moje Recenzje";
}

<div class="container mt-4">
    <div class="d-flex flex-column flex-md-row justify-content-between align-items-md-center mb-5 gap-3 border-bottom border-glass pb-3">
        <div class="d-flex align-items-center gap-3">
            <i class="bi bi-chat-left-quote" style="font-size: 2.5rem; color: var(--accent-primary);"></i>
            <div>
                <h1 class="display-6 fw-bold text-white m-0">Moje Recenzje</h1>
                <p class="text-muted m-0 small">Opinie o grach, które napisałeś</p>
            </div>
        </div>
        <a asp-action="Index" class="btn btn-glass d-flex align-items-center gap-2 align-self-start align-self-md-auto">
            <i class="bi bi-arrow-left"></i> Wróć do biblioteki
        </a>
    </div>

    <div class="row g-4">
        @if (Model != null && Model.Any())
        {
            foreach (var review in Model)
            {
                <div class="col-12 col-md-6 col-xl-4">
                    <div class="glass-card h-100 d-flex flex-column p-4">
                        <div class="d-flex justify-content-between align-items-start mb-3 border-bottom border-glass pb-2">
                            <h5 class="text-white fw-bold mb-0 pe-2">
                                <i class="bi bi-joystick text-info me-1"></i> @review.Game?.Title
                            </h5>
                            <span class="badge fs-6 border border-warning" style="background-color: rgba(255, 193, 7, 0.15); color: #ffc107;">
                                <i class="bi bi-star-fill"></i> @review.Rating/10
                            </span>
                        </div>

                        <div class="card-body p-0 flex-grow-1">
                            <p class="text-muted mb-0" style="text-align: justify; line-height: 1.6; font-style: italic;">
                                "@review.Content"
                            </p>
                        </div>

                        <div class="mt-3 pt-3 border-top border-glass text-end text-muted small">
                            <i class="bi bi-calendar-check me-1"></i> Napisano: @review.CreatedAt.ToString("dd.MM.yyyy HH:mm")
                        </div>
                    </div>
                </div>
            }
        }
        else
        {
            <div class="col-12">
                <div class="alert glass-card text-muted d-flex align-items-center gap-3">
                    <i class="bi bi-pen fs-4 text-warning"></i>
                    Nie napisałeś jeszcze żadnej recenzji. Wejdź na profil gry, aby to zmienić!
                </div>
            </div>
        }
    </div>
</div>