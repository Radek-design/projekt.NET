@model IEnumerable<projekt.NET.Models.Screenshot>
@{
    ViewData["Title"] = "Moje Zrzuty Ekranu";
}

<div class="container mt-4">
    <h2 class="text-warning mb-4 border-bottom border-secondary pb-2"><i class="bi bi-images"></i> Twoja Galeria</h2>
    <a asp-action="Index" class="btn btn-outline-secondary mb-4"><i class="bi bi-arrow-left"></i> Wróć do biblioteki</a>

    <div class="row">
        <div class="col-md-4 mb-4">
            <div class="card bg-dark text-white border-info shadow-sm">
                <div class="card-header bg-info text-dark fw-bold">Dodaj Zrzut Ekranu</div>
                <div class="card-body">
                    <form asp-action="AddScreenshot" method="post">
                        <label class="small text-info fw-bold">Link do grafiki (URL):</label>
                        <input type="url" name="imagePath" required class="form-control form-control-sm bg-dark text-white border-secondary mb-2" />

                        <label class="small text-info fw-bold">Wybierz grę:</label>
                        <select name="gameId" required class="form-select form-select-sm bg-dark text-white border-secondary mb-3">
                            @foreach (var g in ViewBag.Games)
                            {
                                <option value="@g.Id">@g.Title</option>
                            }
                        </select>
                        <button type="submit" class="btn btn-info btn-sm text-dark fw-bold w-100">Zapisz w galerii</button>
                    </form>
                </div>
            </div>
        </div>

        <div class="col-md-8">
            <form method="get" asp-action="Screenshots" class="d-flex mb-3">
                <select name="gameId" class="form-select form-select-sm bg-dark text-white border-secondary w-auto me-2" onchange="this.form.submit()">
                    <option value="">-- Pokaż zrzuty ze wszystkich gier --</option>
                    @foreach (var g in ViewBag.Games)
                    {
                        if (ViewBag.SelectedGame == g.Id)
                        {
                            <option value="@g.Id" selected>@g.Title</option>
                        }
                        else
                        {
                            <option value="@g.Id">@g.Title</option>
                        }
                    }
                </select>
                <noscript><button type="submit" class="btn btn-primary btn-sm">Filtruj</button></noscript>
            </form>

            <div class="row">
                @if (Model.Any())
                {
                    foreach (var s in Model)
                    {
                        <div class="col-md-6 mb-3">
                            <div class="card bg-dark border-secondary">
                                <img src="@s.ImagePath" class="card-img-top" style="height:200px; object-fit:cover;">
                                <div class="card-footer bg-transparent border-secondary text-center small text-light">Gra: @s.Game?.Title</div>
                            </div>
                        </div>
                    }
                }
                else
                {
                    <div class="col-12"><div class="alert alert-secondary">Brak zrzutów ekranu spełniających kryteria.</div></div>
                }
            </div>
        </div>
    </div>
</div>