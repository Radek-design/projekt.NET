<!DOCTYPE html>
<html lang="pl">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - Baza Gier</title>

    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css">

    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/projekt.NET.styles.css" asp-append-version="true" />
</head>
<body>
    <header>
        <nav class="navbar navbar-expand-lg glass-nav fixed-top box-shadow">
            <div class="container-fluid px-4 px-lg-5">

                <a class="navbar-brand d-flex align-items-center gap-2 fs-3" asp-area="" asp-controller="Home" asp-action="Index">
                    <i class="bi bi-controller text-info"></i>
                    <span>Baza Gier</span>
                </a>

                <button class="navbar-toggler border-0 shadow-none" type="button" data-bs-toggle="collapse" data-bs-target="#navbarMainContent" aria-controls="navbarMainContent" aria-expanded="false" aria-label="Rozwiń nawigację">
                    <i class="bi bi-list text-info" style="font-size: 2.5rem;"></i>
                </button>

                <div class="collapse navbar-collapse" id="navbarMainContent">
                    <ul class="navbar-nav mx-auto mb-2 mb-lg-0 gap-1 gap-lg-3">
                        <li class="nav-item">
                            <a class="nav-link d-flex align-items-center gap-2" asp-area="" asp-controller="Home" asp-action="Index">
                                <i class="bi bi-house-door"></i> Strona główna
                            </a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link d-flex align-items-center gap-2" asp-area="" asp-controller="Games" asp-action="Index">
                                <i class="bi bi-grid"></i> Katalog Gier
                            </a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link d-flex align-items-center gap-2" asp-area="" asp-controller="Library" asp-action="Index">
                                <i class="bi bi-collection-play"></i> Moja biblioteka
                            </a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link d-flex align-items-center gap-2" asp-area="" asp-controller="Forum" asp-action="Index">
                                <i class="bi bi-chat-square-text"></i> Forum
                            </a>
                        </li>
                    </ul>

                    <div class="d-flex align-items-center mt-3 mt-lg-0">
                        @if (User.Identity != null && User.Identity.IsAuthenticated)
                        {
                            <div class="d-flex align-items-center gap-3">
                                <div class="text-white d-none d-md-block">
                                    <span class="text-muted small">Zalogowany jako</span><br />
                                    <span class="fw-bold" style="color: var(--accent-primary);">@User.Identity.Name</span>
                                </div>
                                <form asp-controller="Account" asp-action="Logout" method="post" class="m-0">
                                    <button type="submit" class="btn btn-glass btn-sm d-flex align-items-center gap-2 px-3 py-2">
                                        <i class="bi bi-box-arrow-right"></i> Wyloguj
                                    </button>
                                </form>
                            </div>
                        }
                        else
                        {
                            <a asp-controller="Account" asp-action="Login" class="btn btn-neon d-flex align-items-center gap-2">
                                <i class="bi bi-person-circle"></i> Zaloguj / Rejestracja
                            </a>
                        }
                    </div>
                </div>
            </div>
        </nav>
    </header>

    <div class="main-content">
        <div class="container">
            <main role="main" class="pb-5">
                @RenderBody()
            </main>
        </div>
    </div>

    <footer class="footer">
        <div class="container text-center">
            <span class="text-muted">
                &copy; 2026 - <span class="fw-bold text-light">Baza Gier (Michał & Radosław)</span> -
                <a asp-area="" asp-controller="Home" asp-action="Privacy" class="text-info">Polityka Prywatności</a>
            </span>
        </div>
    </footer>

    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>