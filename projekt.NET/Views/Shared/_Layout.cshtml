<!DOCTYPE html>
<html lang="pl">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - Baza Gier</title>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/projekt.NET.styles.css" asp-append-version="true" />
</head>
<body class="bg-dark text-light">
    <header>
        <nav class="navbar navbar-expand-sm navbar-toggleable-sm navbar-dark bg-dark border-bottom box-shadow mb-3">
            <div class="container-fluid px-4 position-relative">
                <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target=".navbar-collapse" aria-controls="navbarSupportedContent"
                        aria-expanded="false" aria-label="Toggle navigation">
                    <span class="navbar-toggler-icon"></span>
                </button>
                <div class="d-flex align-items-center">
                    <a asp-area="" asp-controller="Home" asp-action="Index" class="text-decoration-none fs-2 me-3">🕹️</a>
                </div>

                <div class="navbar-collapse collapse d-sm-flex align-items-center justify-content-around w-100">

                    <div class="d-flex align-items-center">
                        <ul class="navbar-nav align-items-center">
                            <li class="nav-item">
                                <a class="nav-link text-white" asp-area="" asp-controller="Home" asp-action="Index">Strona główna</a>
                            </li>
                            <li class="nav-item">
                                <a class="nav-link text-white" asp-area="" asp-controller="Games" asp-action="Index">Wszystkie gry</a>
                            </li>
                        </ul>
                    </div>

                    <div class="position-absolute top-50 start-50 translate-middle d-none d-lg-block">
                        <span class="navbar-brand fs-2 fw-bold text-info m-0">Baza Gier</span>
                    </div>

                    <div class="d-flex align-items-center">
                        <ul class="navbar-nav align-items-center">
                            <li class="nav-item">
                                <a class="nav-link text-white" asp-area="" asp-controller="Library" asp-action="Index">Moja biblioteka</a>
                            </li>
                            <li class="nav-item">
                                <a class="nav-link text-white" asp-area="" asp-controller="Forum" asp-action="Index">Forum</a>
                            </li>
                        </ul>
                    </div>
                </div>
                <div class="d-flex align-items-center">
                    <a class="nav-link btn btn-outline-info text-info me-2" href="#">Zaloguj</a>
                </div>
            </div>
        </nav>
    </header>
    <div class="container">
        <main role="main" class="pb-3">
            @RenderBody()
        </main>
    </div>

    <footer class="border-top border-secondary footer text-muted mt-5">
        <div class="container text-center text-light">
            &copy; 2026 - Baza Gier (Michał & Radosław) - <a asp-area="" asp-controller="Home" asp-action="Privacy" class="text-info">Prywatność</a>
        </div>
    </footer>
    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>